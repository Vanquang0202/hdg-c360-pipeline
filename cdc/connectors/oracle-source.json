{
  "name": "hdg-oracle-observe",
  "config": {
    "connector.class": "io.debezium.connector.oracle.OracleConnector",
    "tasks.max": "1",
    "database.hostname": "hdg-c360-oracle",
    "database.port": "1521",
    "database.user": "C##HDG_CDC",
    "database.password": "${env:ORACLE_CDC_PASSWORD}",
    "database.dbname": "FREE",
    "database.pdb.name": "FREEPDB1",
    "database.connection.adapter": "logminer",
    "topic.prefix": "hdg_observe",
    "schema.include.list": "VSS",
    "table.include.list": "VSS\\.VSS_HO_GD_NHANKHAU,VSS\\.VSS_DM_DANTOC,VSS\\.VSS_DM_QUOC_TICH,VSS\\.VSS_DM_DBHC",
    "snapshot.mode": "no_data",
    "log.mining.strategy": "online_catalog",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "hdg-observe-schema-history",
    "schema.history.internal.store.only.captured.tables.ddl": "true",
    "include.schema.changes": "false",
    "provide.transaction.metadata": "true",
    "tombstones.on.delete": "true",
    "decimal.handling.mode": "precise",
    "max.batch.size": "512",
    "max.queue.size": "2048",
    "max.queue.size.in.bytes": "16777216",
    "poll.interval.ms": "1000",
    "heartbeat.interval.ms": "10000",
    "log.mining.batch.size.min": "1000",
    "log.mining.batch.size.default": "5000",
    "log.mining.batch.size.max": "20000",
    "log.mining.batch.size.increment": "1000",
    "log.mining.session.max.ms": "600000",
    "log.mining.transaction.retention.ms": "0",
    "errors.tolerance": "none"
  }
}
